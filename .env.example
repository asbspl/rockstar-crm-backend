NODE_ENV=development
PORT=5000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_existing_database
DB_USER=your_existing_database_user
DB_PASSWORD=your_existing_database_password

JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=1d

FRONTEND_URL=http://localhost:5173

# Match these names to existing public-schema tables and columns; no tables are created.
AUTH_USER_TABLE=users
AUTH_USER_ID_COLUMN=id
AUTH_USER_EMAIL_COLUMN=email
AUTH_USER_PASSWORD_COLUMN=password_hash
LEADS_TABLE=leads
LEADS_STATUS_COLUMN=status