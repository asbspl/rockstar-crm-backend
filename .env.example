NODE_ENV=development

PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rockstar_crm
DB_USER=postgres
DB_PASSWORD=change_me

JWT_SECRET=replace_with_a_secure_random_32_plus_character_secret
JWT_REFRESH_SECRET=replace_with_a_different_secure_random_32_plus_character_secret
JWT_ISSUER=rockstar-crm
JWT_AUDIENCE=rockstar-crm-users
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_EXPIRES_IN=1d
PASSWORD_RESET_EXPIRES_IN=1h
REFRESH_COOKIE_NAME=rockstar_refresh_token
FRONTEND_URL=http://localhost:5173

# Match these names to existing public-schema tables and columns.
AUTH_USER_TABLE=users
AUTH_USER_ID_COLUMN=id
AUTH_USER_EMAIL_COLUMN=email
AUTH_USER_PASSWORD_COLUMN=password_hash
LEADS_TABLE=leads
LEADS_STATUS_COLUMN=status

# Create the first Super Admin securely with a one-time bootstrap command.
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_SUPER_ADMIN_PASSWORD=change_me_before_use
BOOTSTRAP_SUPER_ADMIN_NAME=System Administrator



